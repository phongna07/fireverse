VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
VITE_GIPHY_API_KEY=your_api_key

# Cloudinary: cloud name + unsigned upload preset (no API key/secret needed).
# Image uploads turn on automatically when both are set. Maximum: 2 MB.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: WebRTC ICE servers as a JSON array. Defaults to Google's public
# STUN servers. Add a TURN server here if calls fail to connect on some networks.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"","credential":""}]
